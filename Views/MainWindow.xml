<Window Background="{DynamicResource WindowBackgroundBrush}" Height="740" Title="PureMedia Studio — Zero-Dependency Native Player" Width="1120" x:Class="PureMediaPlayer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:theming="clr-namespace:PureMediaPlayer.Services.Theming" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: URL / File Input, Web Scraper & Theme Selector -->
        <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Grid.Row="0" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Command="{Binding BrowseLocalFileCommand}" Content="Open File" Grid.Column="0" Margin="0,0,8,0" Padding="12,6"/>
                <TextBox Grid.Column="1" Margin="0,0,8,0" Padding="8,4" Text="{Binding InputUrlOrPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                <Button Command="{Binding LoadOrScrapeUrlCommand}" Content="Load / Scrape Webpage" Grid.Column="2" Margin="0,0,16,0" Padding="14,6"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0" Text="Theme:" VerticalAlignment="Center"/>
                    <ComboBox SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag" Width="130">
                        <ComboBoxItem Content="System Default" Tag="{x:Static theming:ThemeMode.SystemDefault}"/>
                        <ComboBoxItem Content="Dark" Tag="{x:Static theming:ThemeMode.Dark}"/>
                        <ComboBoxItem Content="Light" Tag="{x:Static theming:ThemeMode.Light}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Viewport & Discovered Webpage Streams -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="Black" ClipToBounds="True" CornerRadius="8" Grid.Column="0" Margin="0,0,12,0">
                <Image Source="{Binding VideoBitmap}" Stretch="Uniform"/>
            </Border>

            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Grid.Column="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" Text="Discovered Web Streams"/>
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding DiscoveredStreams}" SelectedItem="{Binding SelectedStream}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="{Binding FormatHint}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DiscoverySource}"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding StreamUri}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Transport, High-Res Audio DSP & AES-256 Encryption Controls -->
        <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Grid.Row="2" Margin="0,12,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Command="{Binding TogglePlayPauseCommand}" Content="Play / Pause" Grid.Column="0" Margin="0,0,16,0" Padding="16,6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" Text="DSP Gain:" VerticalAlignment="Center"/>
                    <Slider Maximum="2.0" Minimum="0.0" Value="{Binding AudioGain}" VerticalAlignment="Center" Width="130"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0" Text="AES-256 Key:" VerticalAlignment="Center"/>
                    <TextBox Margin="0,0,8,0" Text="{Binding EncryptionPassphrase, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Width="160"/>
                    <Button Command="{Binding EncryptCurrentMediaCommand}" Content="Encrypt (.pmpe)" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Grid.Row="3" Text="{Binding StatusBanner}"/>
    </Grid>
</Window>